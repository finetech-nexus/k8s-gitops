      <di:waypoint x="2005" y="105" />
      <di:waypoint x="2005" y="120" />
      <di:waypoint x="2680" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fYes_di" bpmnElement="fYes">
      <di:waypoint x="1330" y="105" />
      <di:waypoint x="1480" y="105" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fResumeLow_di" bpmnElement="fResumeLow">
      <di:waypoint x="1530" y="105" />
      <di:waypoint x="1605" y="105" />
      <di:waypoint x="1605" y="400" />
      <di:waypoint x="1680" y="400" />
    </bpmndi:BPMNEdge>
