    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="decide_di" bpmnElement="decide" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="1370" y="80" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gUser_di" bpmnElement="gUser" isMarkerVisible="true">
