      <di:waypoint x="1330" y="385" />
      <di:waypoint x="1505" y="385" />
      <di:waypoint x="1505" y="120" />
      <di:waypoint x="1680" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fAsk_di" bpmnElement="fAsk">
      <di:waypoint x="1600" y="260" />
      <di:waypoint x="1640" y="260" />
      <di:waypoint x="1640" y="238" />
      <di:waypoint x="1680" y="238" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fLow_di" bpmnElement="fLow">
      <di:waypoint x="1800" y="400" />
      <di:waypoint x="1840" y="400" />
      <di:waypoint x="1840" y="260" />
      <di:waypoint x="1880" y="260" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fCancelled_di" bpmnElement="fCancelled">
      <di:waypoint x="2000" y="260" />
      <di:waypoint x="2340" y="260" />
      <di:waypoint x="2340" y="120" />
      <di:waypoint x="2680" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fClaim_di" bpmnElement="fClaim">
      <di:waypoint x="1800" y="120" />
      <di:waypoint x="1840" y="120" />
      <di:waypoint x="1840" y="105" />
      <di:waypoint x="1880" y="105" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fSkip_di" bpmnElement="fSkip">
      <di:waypoint x="1930" y="105" />
      <di:waypoint x="2305" y="105" />
      <di:waypoint x="2305" y="120" />
      <di:waypoint x="2680" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fDoBlock_di" bpmnElement="fDoBlock">
      <di:waypoint x="1930" y="105" />
      <di:waypoint x="2005" y="105" />
      <di:waypoint x="2005" y="120" />
      <di:waypoint x="2080" y="120" />
