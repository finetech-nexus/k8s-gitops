<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_mt_in_auth" targetNamespace="http://nbank.fr/payment-hub">
  <bpmn:process id="mt_inbound_authorization-DFSPID" name="mt_inbound_authorization-DFSPID" isExecutable="true">
    <bpmn:startEvent id="start" name="Authorization from Monétique Tunisie">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="find" name="Identify the account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtFindAccountByPan" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gAccount" name="Account found" default="fReady">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>fReady</bpmn:outgoing>
      <bpmn:outgoing>fMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="balance" name="Check the balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtCheckBalance" />
      </bpmn:extensionElements>
      <bpmn:incoming>fReady</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gDecision" name="User already decided" default="fFirst">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>fFirst</bpmn:outgoing>
      <bpmn:outgoing>fResume</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="decide" name="Apply the user decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtApplyUserDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>fResume</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gUser" name="User confirmed" default="fCancel">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>fCancel</bpmn:outgoing>
      <bpmn:outgoing>fYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gResumeBal" name="Balance after confirmation" default="fResumeLow">
      <bpmn:incoming>fYes</bpmn:incoming>
      <bpmn:outgoing>fResumeLow</bpmn:outgoing>
      <bpmn:outgoing>fResumeOk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gConfirm" name="Confirmation required" default="fNoConfirm">
      <bpmn:incoming>fFirst</bpmn:incoming>
      <bpmn:outgoing>fNoConfirm</bpmn:outgoing>
      <bpmn:outgoing>fNeed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gEcomBal" name="Balance before asking" default="fEcomLow">
      <bpmn:incoming>fNeed</bpmn:incoming>
      <bpmn:outgoing>fEcomLow</bpmn:outgoing>
      <bpmn:outgoing>fEcomOk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gPosBal" name="Balance for a direct payment" default="fPosLow">
      <bpmn:incoming>fNoConfirm</bpmn:incoming>
      <bpmn:outgoing>fPosLow</bpmn:outgoing>
      <bpmn:outgoing>fPosOk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ask" name="Ask the cardholder">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtRequestCardholderConfirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>fEcomOk</bpmn:incoming>
      <bpmn:outgoing>fAsk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endWait" name="Waiting for the cardholder">
      <bpmn:incoming>fAsk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="insufficient" name="Notify insufficient balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtNotifyInsufficientBalance" />
      </bpmn:extensionElements>
      <bpmn:incoming>fEcomLow</bpmn:incoming>
      <bpmn:incoming>fPosLow</bpmn:incoming>
      <bpmn:incoming>fResumeLow</bpmn:incoming>
      <bpmn:outgoing>fLow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="cancelledLine" name="Record the cancelled debit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtRecordCancelledDebit" />
      </bpmn:extensionElements>
      <bpmn:incoming>fLow</bpmn:incoming>
      <bpmn:outgoing>fCancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="claim" name="Claim the hold once">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtClaimBlock" />
      </bpmn:extensionElements>
      <bpmn:incoming>fPosOk</bpmn:incoming>
      <bpmn:incoming>fResumeOk</bpmn:incoming>
      <bpmn:outgoing>fClaim</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gClaim" name="Hold not already taken" default="fSkip">
      <bpmn:incoming>fClaim</bpmn:incoming>
      <bpmn:outgoing>fSkip</bpmn:outgoing>
      <bpmn:outgoing>fDoBlock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="block" name="Block the funds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="block-funds" />
      </bpmn:extensionElements>
      <bpmn:incoming>fDoBlock</bpmn:incoming>
      <bpmn:outgoing>fBlocked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gBlock" name="Hold result" default="fHeld">
      <bpmn:incoming>fBlocked</bpmn:incoming>
      <bpmn:outgoing>fHeld</bpmn:outgoing>
      <bpmn:outgoing>fBlockKo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="marked" name="Record the blocked funds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtMarkFundsBlocked" />
      </bpmn:extensionElements>
      <bpmn:incoming>fHeld</bpmn:incoming>
      <bpmn:outgoing>fMarked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reply" name="Reply to Monétique Tunisie">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mtReplyToNetwork" />
      </bpmn:extensionElements>
      <bpmn:incoming>fMissing</bpmn:incoming>
      <bpmn:incoming>fCancel</bpmn:incoming>
      <bpmn:incoming>fCancelled</bpmn:incoming>
      <bpmn:incoming>fSkip</bpmn:incoming>
      <bpmn:incoming>fBlockKo</bpmn:incoming>
      <bpmn:incoming>fMarked</bpmn:incoming>
      <bpmn:outgoing>fEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Authorization closed">
      <bpmn:incoming>fEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="find" />
    <bpmn:sequenceFlow id="f2" sourceRef="find" targetRef="gAccount" />
    <bpmn:sequenceFlow id="fReady" sourceRef="gAccount" targetRef="balance" />
    <bpmn:sequenceFlow id="fMissing" name="Account not found" sourceRef="gAccount" targetRef="reply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=partyLookupFailed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f3" sourceRef="balance" targetRef="gDecision" />
    <bpmn:sequenceFlow id="fFirst" sourceRef="gDecision" targetRef="gConfirm" />
    <bpmn:sequenceFlow id="fResume" name="Decision already known" sourceRef="gDecision" targetRef="decide">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=awaitingDecision = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="decide" targetRef="gUser" />
    <bpmn:sequenceFlow id="fCancel" sourceRef="gUser" targetRef="reply" />
    <bpmn:sequenceFlow id="fYes" name="Confirmed" sourceRef="gUser" targetRef="gResumeBal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=userConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fResumeLow" sourceRef="gResumeBal" targetRef="insufficient" />
    <bpmn:sequenceFlow id="fResumeOk" name="Balance covers the payment" sourceRef="gResumeBal" targetRef="claim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=balanceSufficient = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fNoConfirm" sourceRef="gConfirm" targetRef="gPosBal" />
    <bpmn:sequenceFlow id="fNeed" name="Card requires confirmation" sourceRef="gConfirm" targetRef="gEcomBal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confirmationRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fEcomLow" sourceRef="gEcomBal" targetRef="insufficient" />
    <bpmn:sequenceFlow id="fEcomOk" name="Balance covers the payment" sourceRef="gEcomBal" targetRef="ask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=balanceSufficient = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fPosLow" sourceRef="gPosBal" targetRef="insufficient" />
    <bpmn:sequenceFlow id="fPosOk" name="Balance covers the payment" sourceRef="gPosBal" targetRef="claim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=balanceSufficient = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fAsk" sourceRef="ask" targetRef="endWait" />
    <bpmn:sequenceFlow id="fLow" sourceRef="insufficient" targetRef="cancelledLine" />
    <bpmn:sequenceFlow id="fCancelled" sourceRef="cancelledLine" targetRef="reply" />
    <bpmn:sequenceFlow id="fClaim" sourceRef="claim" targetRef="gClaim" />
    <bpmn:sequenceFlow id="fSkip" sourceRef="gClaim" targetRef="reply" />
    <bpmn:sequenceFlow id="fDoBlock" name="First hold" sourceRef="gClaim" targetRef="block">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=blockClaimed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fBlocked" sourceRef="block" targetRef="gBlock" />
    <bpmn:sequenceFlow id="fHeld" sourceRef="gBlock" targetRef="marked" />
    <bpmn:sequenceFlow id="fBlockKo" name="Hold failed" sourceRef="gBlock" targetRef="reply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=transferPrepareFailed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fMarked" sourceRef="marked" targetRef="reply" />
    <bpmn:sequenceFlow id="fEnd" sourceRef="reply" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
