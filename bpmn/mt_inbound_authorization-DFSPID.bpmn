      <bpmndi:BPMNLabel><dc:Bounds x="2117" y="151" width="96" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gResumeBal_di" bpmnElement="gResumeBal" isMarkerVisible="true">
      <dc:Bounds x="2280" y="95" width="50" height="50" />
      <bpmndi:BPMNLabel><dc:Bounds x="2221" y="151" width="168" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="claim_di" bpmnElement="claim" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="2420" y="80" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gClaim_di" bpmnElement="gClaim" isMarkerVisible="true">
      <dc:Bounds x="2670" y="95" width="50" height="50" />
    </bpmndi:BPMNShape>
