      <dc:Bounds x="1420" y="395" width="50" height="50" />
      <bpmndi:BPMNLabel><dc:Bounds x="1376" y="451" width="138" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ask_di" bpmnElement="ask" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="1560" y="380" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="endWait_di" bpmnElement="endWait" bioc:stroke="rgb(67, 160, 71)" bioc:fill="rgb(200, 230, 201)">
      <dc:Bounds x="1820" y="402" width="36" height="36" />
      <bpmndi:BPMNLabel><dc:Bounds x="1754" y="444" width="168" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
