    <bpmndi:BPMNShape id="gResumeBal_di" bpmnElement="gResumeBal">
      <dc:Bounds x="1480" y="80" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gConfirm_di" bpmnElement="gConfirm">
      <dc:Bounds x="1080" y="220" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gEcomBal_di" bpmnElement="gEcomBal">
      <dc:Bounds x="1280" y="220" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gPosBal_di" bpmnElement="gPosBal">
      <dc:Bounds x="1280" y="360" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="ask_di" bpmnElement="ask">
      <dc:Bounds x="1480" y="220" width="120" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="endWait_di" bpmnElement="endWait">
      <dc:Bounds x="1680" y="220" width="36" height="36" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="insufficient_di" bpmnElement="insufficient">
      <dc:Bounds x="1680" y="360" width="120" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="cancelledLine_di" bpmnElement="cancelledLine">
      <dc:Bounds x="1880" y="220" width="120" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="claim_di" bpmnElement="claim">
