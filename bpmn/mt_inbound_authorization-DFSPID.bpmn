      <dc:Bounds x="1620" y="680" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="cancelledLine_di" bpmnElement="cancelledLine" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="1880" y="680" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
      <di:waypoint x="96" y="120" />
      <di:waypoint x="170" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fCard_di" bpmnElement="fCard">
      <di:waypoint x="350" y="120" />
      <di:waypoint x="400" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fLookup_di" bpmnElement="fLookup">
      <di:waypoint x="450" y="120" />
      <di:waypoint x="600" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fCardMissing_di" bpmnElement="fCardMissing">
      <di:waypoint x="425" y="145" />
      <di:waypoint x="425" y="1180" />
      <di:waypoint x="3500" y="1180" />
      <di:waypoint x="3500" y="160" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
      <di:waypoint x="780" y="120" />
      <di:waypoint x="880" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fReady_di" bpmnElement="fReady">
      <di:waypoint x="930" y="120" />
      <di:waypoint x="1000" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fMissing_di" bpmnElement="fMissing">
      <di:waypoint x="905" y="145" />
      <di:waypoint x="905" y="1040" />
      <di:waypoint x="3500" y="1040" />
      <di:waypoint x="3500" y="160" />
      <bpmndi:BPMNLabel><dc:Bounds x="915" y="115" width="118" height="20" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
      <di:waypoint x="1180" y="120" />
      <di:waypoint x="1250" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fResume_di" bpmnElement="fResume">
      <di:waypoint x="1300" y="120" />
      <di:waypoint x="1370" y="120" />
      <bpmndi:BPMNLabel><dc:Bounds x="1310" y="90" width="148" height="20" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fFirst_di" bpmnElement="fFirst">
      <di:waypoint x="1275" y="145" />
      <di:waypoint x="1275" y="395" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
      <di:waypoint x="1550" y="120" />
      <di:waypoint x="1590" y="120" />
      <di:waypoint x="1590" y="40" />
      <di:waypoint x="2100" y="40" />
      <di:waypoint x="2100" y="120" />
      <di:waypoint x="2140" y="120" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="fYes_di" bpmnElement="fYes">
      <di:waypoint x="2190" y="120" />
      <di:waypoint x="2280" y="120" />
      <bpmndi:BPMNLabel><dc:Bounds x="2200" y="90" width="90" height="20" /></bpmndi:BPMNLabel>
