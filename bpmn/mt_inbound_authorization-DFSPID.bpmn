      <dc:Bounds x="880" y="95" width="50" height="50" />
      <bpmndi:BPMNLabel><dc:Bounds x="860" y="151" width="90" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="balance_di" bpmnElement="balance" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="1000" y="80" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gDecision_di" bpmnElement="gDecision" isMarkerVisible="true">
      <dc:Bounds x="1250" y="95" width="50" height="50" />
