      <dc:Bounds x="2790" y="80" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gBlock_di" bpmnElement="gBlock" isMarkerVisible="true">
      <dc:Bounds x="3040" y="95" width="50" height="50" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="marked_di" bpmnElement="marked" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="3160" y="80" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="reply_di" bpmnElement="reply" bioc:stroke="rgb(142, 36, 170)" bioc:fill="rgb(225, 190, 231)">
      <dc:Bounds x="3410" y="80" width="180" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="end_di" bpmnElement="end" bioc:stroke="rgb(67, 160, 71)" bioc:fill="rgb(200, 230, 201)">
      <dc:Bounds x="3660" y="102" width="36" height="36" />
      <bpmndi:BPMNLabel><dc:Bounds x="3612" y="144" width="132" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="gConfirm_di" bpmnElement="gConfirm" isMarkerVisible="true">
      <dc:Bounds x="1250" y="395" width="50" height="50" />
      <bpmndi:BPMNLabel><dc:Bounds x="1206" y="451" width="138" height="27" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
